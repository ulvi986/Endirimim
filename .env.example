# Server-side only. Never commit real secrets. Copy to .env before running the API:
#   cp .env.example .env

# --- Required ---------------------------------------------------------------
# Replace YOUR_PASSWORD with the password you chose when installing PostgreSQL.
# On Windows the default superuser is "postgres". Then run:
#   npm run db:setup     (creates the database)
#   npm run db:migrate   (creates the tables)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/endirimim

# HS256 signing key for access tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Public URL of the Vite app. Used to build password reset links.
APP_URL=http://localhost:5173
# Set to true only when the API sits behind a trusted reverse proxy.
TRUST_PROXY=false

# --- Database tuning --------------------------------------------------------
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Token lifetimes (seconds) ---------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=3600
# A rotated refresh token reused within this many seconds is treated as two tabs
# refreshing at once rather than theft. 0 = strict (any reuse revokes all sessions).
REFRESH_REUSE_GRACE_SECONDS=10

# --- Cookies ----------------------------------------------------------------
# lax | strict | none. Use "none" when the web app and API are on different sites
# (e.g. app.example.com vs api.other.com); it forces Secure, so HTTPS is required.
COOKIE_SAME_SITE=lax

# --- Object storage ---------------------------------------------------------
# "local" writes to STORAGE_LOCAL_DIR and the API serves it at /uploads.
# "vercel-blob" is required on Vercel (functions have no persistent disk); it
# reads BLOB_READ_WRITE_TOKEN, which Vercel injects once a Blob store is connected.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=server/uploads
# Optional. Local default: http://localhost:$PORT/uploads. Blob default: derived from the token.
STORAGE_PUBLIC_URL=
BLOB_READ_WRITE_TOKEN=
# Vercel caps request bodies at 4.5 MB, so uploads stay at or below 4 MB.
MAX_UPLOAD_BYTES=4194304

# --- Email (optional locally, needed in production) -------------------------
# Without these, emails are printed to the console in development and dropped in
# production — so password reset would not reach users.
# MAIL_FROM must use a domain verified in Resend, e.g. "Endirimim <no-reply@example.com>".
RESEND_API_KEY=
MAIL_FROM=

